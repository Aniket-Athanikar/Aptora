# ──────────────────────────────────────────────
# ExamForge AI — Environment Variables Template
# ──────────────────────────────────────────────
# Copy this file to backend/.env and fill in your values.
# DO NOT commit the actual .env file with real secrets.

# ── Application ──────────────────────────────
ENV=development
PORT=8000
HOST=0.0.0.0
PROJECT_NAME="ExamForge-AI-Backend"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
SECRET_KEY=your-secret-key-here
DEBUG=True

# ── Database (PostgreSQL) ────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=Exame_forgeDB
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# ── Redis ────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Qdrant Vector DB ────────────────────────
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ── Email (SMTP) ─────────────────────────────
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com

# ── Frontend ─────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
